# Classification models are fixed provider entries. Select one or more IDs.
# mimo-v2.5-free (OpenCode Zen free tier) needs no API key.
SCIRSS_CLASSIFIER_ENABLED_MODELS=deepseek-v4-flash,mimo-v2.5-free
SCIRSS_CLASSIFIER_DEFAULT_MODEL=deepseek-v4-flash
SCIRSS_DEEPSEEK_API_KEY=your-deepseek-classifier-key
SCIRSS_GLM_API_KEY=
QWEN_API_KEY=
MIMO_API_KEY=
SCIRSS_CLASSIFIER_BATCH_SIZE=5
# Optional global preference for managed classifier models. GLM always remains at low.
SCIRSS_CLASSIFIER_THINKING=disabled

# Legacy classifier variables are accepted for migration and should not be used for new setups.
# SCIRSS_CLASSIFIER_API_KEY=your-classifier-provider-key
# SCIRSS_CLASSIFIER_BASE_URL=https://api.deepseek.com
# SCIRSS_CLASSIFIER_MODEL=deepseek-v4-flash

SCIRSS_PROFILE_API_KEY=your-profile-provider-key
SCIRSS_PROFILE_BASE_URL=https://api.deepseek.com
SCIRSS_PROFILE_MODEL=deepseek-v4-pro
SCIRSS_PROFILE_THINKING=enabled

# DeepSeek prices in CNY per 1M tokens. Peak applies on Beijing weekdays only.
SCIRSS_DEEPSEEK_FLASH_OFF_PEAK_CACHE_HIT_CNY_PER_MILLION=0.05
SCIRSS_DEEPSEEK_FLASH_OFF_PEAK_CACHE_MISS_CNY_PER_MILLION=1.5
SCIRSS_DEEPSEEK_FLASH_OFF_PEAK_OUTPUT_CNY_PER_MILLION=4.5
SCIRSS_DEEPSEEK_FLASH_PEAK_CACHE_HIT_CNY_PER_MILLION=0.1
SCIRSS_DEEPSEEK_FLASH_PEAK_CACHE_MISS_CNY_PER_MILLION=3
SCIRSS_DEEPSEEK_FLASH_PEAK_OUTPUT_CNY_PER_MILLION=9
SCIRSS_DEEPSEEK_PRO_OFF_PEAK_CACHE_HIT_CNY_PER_MILLION=0.15
SCIRSS_DEEPSEEK_PRO_OFF_PEAK_CACHE_MISS_CNY_PER_MILLION=4.5
SCIRSS_DEEPSEEK_PRO_OFF_PEAK_OUTPUT_CNY_PER_MILLION=13.5
SCIRSS_DEEPSEEK_PRO_PEAK_CACHE_HIT_CNY_PER_MILLION=0.3
SCIRSS_DEEPSEEK_PRO_PEAK_CACHE_MISS_CNY_PER_MILLION=9
SCIRSS_DEEPSEEK_PRO_PEAK_OUTPUT_CNY_PER_MILLION=27

# Current GLM-5.3-Flash promotional prices in CNY per 1M tokens.
SCIRSS_GLM_53_FLASH_CACHE_HIT_CNY_PER_MILLION=0.115
SCIRSS_GLM_53_FLASH_CACHE_MISS_CNY_PER_MILLION=0.4
SCIRSS_GLM_53_FLASH_OUTPUT_CNY_PER_MILLION=1.4

# Mainland-China standard pay-as-you-go prices in CNY per 1M tokens (2026-08-29 snapshots).
SCIRSS_QWEN_38_FLASH_CACHE_HIT_CNY_PER_MILLION=0.1
SCIRSS_QWEN_38_FLASH_CACHE_MISS_CNY_PER_MILLION=0.8
SCIRSS_QWEN_38_FLASH_OUTPUT_CNY_PER_MILLION=2.7
SCIRSS_MIMO_V25_CACHE_HIT_CNY_PER_MILLION=0.02
SCIRSS_MIMO_V25_CACHE_MISS_CNY_PER_MILLION=1
SCIRSS_MIMO_V25_OUTPUT_CNY_PER_MILLION=2

SCIRSS_ZOTERO_API_KEY=
SCIRSS_ZOTERO_LIBRARY_TYPE=user
SCIRSS_ZOTERO_LIBRARY_ID=
SCIRSS_ZOTERO_COLLECTION_KEY=

SCIRSS_SERVER_HOST=127.0.0.1
SCIRSS_SERVER_PORT=8000
